modules = ["nodejs-20", "python-3.12", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["file", "gettext", "imagemagick", "jdk17", "libarchive", "libxcrypt", "libxml2", "libxslt", "nginx", "pkg-config", "rabbitmq-server", "redis", "uv", "xmlsec"]

[agent]
expertMode = true

[userenv]

[userenv.development]
UV_PYTHON_DOWNLOADS = "manual"

[userenv.shared]
MCOD_APP_STORAGE_ENABLED = "true"

[userenv.production]
API_URL = "https://mcod-backend-danegovpl.replit.app/api"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Supporting services"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Django admin"

[[workflows.workflow]]
name = "Supporting services"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit/services.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Django admin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 25672
externalPort = 3001
exposeLocalhost = true

[objectStorage]
defaultBucketID = "replit-objstore-d08d3234-3c6d-4ee4-a8df-2c29e98969d5"

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/replit/run-production.sh"]
build = ["bash", "scripts/replit/build.sh"]
ignorePorts = false
