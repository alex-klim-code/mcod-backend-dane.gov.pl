# MCOD project — add secret values only using Replit Secrets:
SESSION_SECRET=
AED_INTEGRATION_SECRET=
# DATABASE_URL is managed by Replit; never copy or override it manually.
# Publishing normally supplies a DIFFERENT production database.
# Approved: separate production DB with an initial dev-data copy via Publishing.
# Later writes do not synchronize. See shared-database.md.
# Keep existing SESSION_SECRET / FIELD_ENCRYPTION_KEYS unchanged.

# Non-secret settings after creating the default private App Storage bucket:
MCOD_APP_STORAGE_ENABLED=true
# Production only: actual Publishing HTTPS URL ending in /api.
# Do not set it as shared: development must keep its own API origin.
# A URL assigned to a failed deployment does not establish service availability.
API_URL=
# Optional custom domain hosts; no protocol or path, comma-separated:
MCOD_ALLOWED_HOSTS=
# Django 2.2 expects host names, not https:// origins:
MCOD_CSRF_TRUSTED_ORIGINS=

# AED Puls backend only — fill from the actual published MCOD URL:
MCOD_API_BASE_URL=
#
# Add the same shared value in AED Puls Secrets:
MCOD_INTEGRATION_SECRET=
