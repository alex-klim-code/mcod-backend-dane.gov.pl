# MCOD project — add secret values only using Replit Secrets:
SESSION_SECRET=
AED_INTEGRATION_SECRET=
# DATABASE_URL is managed by Replit; do not copy it between projects.

# Non-secret settings after creating the default private App Storage bucket:
MCOD_APP_STORAGE_ENABLED=true
# Relative API URLs stay on the current origin.
API_URL=/api
# Optional custom domain hosts; no protocol or path, comma-separated:
MCOD_ALLOWED_HOSTS=
# Django 2.2 expects host names, not https:// origins:
MCOD_CSRF_TRUSTED_ORIGINS=

# AED Puls backend only — fill from the actual published MCOD URL:
MCOD_API_BASE_URL=
# Add the same shared value in AED Puls Secrets:
MCOD_INTEGRATION_SECRET=
